# Alternative to Docker: copy the repo to /opt/kindle-vikunja, put your settings
# in /opt/kindle-vikunja/.env, then:
#   sudo cp deploy/kindle-vikunja.service /etc/systemd/system/
#   sudo systemctl enable --now kindle-vikunja
[Unit]
Description=Kindle e-ink frontend for Vikunja
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/opt/kindle-vikunja/.env
ExecStart=/usr/bin/python3 -u /opt/kindle-vikunja/server/kindle_vikunja.py
Restart=always
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
