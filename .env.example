# --- required -------------------------------------------------------------
# Base URL of your Vikunja instance (with or without /api/v1)
VIKUNJA_URL=https://vikunja.example.com
# API token: Vikunja -> Settings -> API Tokens (see README for permissions)
VIKUNJA_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- optional -------------------------------------------------------------
# Project shown at "/" (otherwise a project picker is shown). Any project is
# also reachable at /p/<id>.
VIKUNJA_PROJECT_ID=1
# If set, the page requires ?key=<ACCESS_KEY> once (then remembered by cookie).
# Use letters/digits only.
ACCESS_KEY=
# How often the list re-syncs with Vikunja, in seconds (min 10)
REFRESH_SECONDS=60
# Sort order of tasks: due | priority | position | title | created
SORT=due
# Base font size in px for the Kindle screen
FONT_SIZE=24
# UI language: en | de
UI_LANG=en
# Timezone used to display due dates
TZ=Europe/Berlin
# Set to 0 for a self-signed Vikunja certificate
VIKUNJA_VERIFY_TLS=1
LISTEN_PORT=8080
