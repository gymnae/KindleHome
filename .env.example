# Configure Vikunja, KitchenOwl or both. With KitchenOwl (or several Vikunja
# projects), "/" shows a dashboard with one tile per list.

# --- Vikunja (todo lists) ----------------------------------------------------
# Base URL of your Vikunja instance (with or without /api/v1)
VIKUNJA_URL=https://vikunja.example.com
# API token: Vikunja -> Settings -> API Tokens (see README for permissions)
VIKUNJA_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Project(s) to show, e.g. "3" or "3,5" (one dashboard tile each). Without a
# dashboard, "/" opens the first one. Any project is reachable at /p/<id>.
VIKUNJA_PROJECT_ID=1

# --- KitchenOwl (shopping list) ------------------------------------------------
# Base URL of your KitchenOwl instance (with or without /api)
KITCHENOWL_URL=
# Long-lived token: KitchenOwl -> Settings -> Profile -> Sessions (see README)
KITCHENOWL_TOKEN=
# Household id (number in the KitchenOwl web URL); empty = the user's first household
KITCHENOWL_HOUSEHOLD_ID=
# Shopping list id; empty = the household's default list
KITCHENOWL_LIST_ID=
# How many "recently bought" items to offer for putting back on the list (0 = none)
KITCHENOWL_RECENT=12
# Set to 0 for a self-signed KitchenOwl certificate
KITCHENOWL_VERIFY_TLS=1
# Item icons (1/0). The icon font is loaded from your own KitchenOwl at runtime
# (it is Icons8's and may not be redistributed, so it is not part of this repo).
KITCHENOWL_ICONS=1
# Where to get it; default: <KITCHENOWL_URL>/assets/fonts/Items.ttf
KITCHENOWL_ICON_FONT_URL=
# Icon name -> character map (KitchenOwl source). Default: current main branch.
# If icons don't show (see server log), use the file of your KitchenOwl version, e.g.
# https://raw.githubusercontent.com/TomBursch/kitchenowl/<tag>/kitchenowl/lib/item_icons.dart
KITCHENOWL_ICON_MAP_URL=

# --- Calendar (upcoming events on the dashboard) --------------------------------
# One or more CalDAV calendar URLs or .ics/webcal links, separated by spaces.
# Nextcloud: https://cloud.example.com/remote.php/dav/calendars/<user>/<calendar>/
CALDAV_URL=
# Login (for Nextcloud best an app password); leave empty for public .ics links
CALDAV_USER=
CALDAV_PASSWORD=
# Tile title (default "Upcoming"), number of events and how many days ahead to look
CALDAV_TITLE=
CALDAV_EVENTS=3
CALDAV_DAYS=30
# Set to 0 for a self-signed certificate
CALDAV_VERIFY_TLS=1

# --- dashboard -----------------------------------------------------------------
# auto (dashboard when KitchenOwl, a calendar or several projects are configured) | 1 | 0
DASHBOARD=auto
# Lists return to the dashboard after this many idle seconds (0 = never)
DASHBOARD_RETURN_SECONDS=0
# Font size in px of the dashboard tiles (the rest uses FONT_SIZE)
DASHBOARD_FONT_SIZE=28
# The Kindle has no emoji font. image = show emoji as small Twemoji pictures
# (fetched by this server, cached) | strip = remove them | keep = leave as is
EMOJI=image
# Where emoji pictures come from ({code} = e.g. 1f6cd)
EMOJI_URL=https://cdn.jsdelivr.net/gh/jdecked/twemoji@15.1.0/assets/72x72/{code}.png

# --- general -------------------------------------------------------------------
# If set, the page requires ?key=<ACCESS_KEY> once (then remembered by cookie).
# Use letters/digits only.
ACCESS_KEY=
# How often the list re-syncs with Vikunja, in seconds (min 10)
REFRESH_SECONDS=60
# Sort order of tasks: position (drag & drop order of Vikunja's list view) |
# due | priority | title | created
SORT=position
# Show subtasks nested in the list (1) or only in the task detail page (0)
LIST_SUBTASKS=0
# Detail page returns to the list after this many idle seconds (0 = never)
DETAIL_RETURN_SECONDS=300
# Time of day for due dates set with the Today/Tomorrow/Weekend chips (HH:MM)
QUICK_DUE_TIME=23:59
# Base font size in px for the Kindle screen
FONT_SIZE=24
# UI language: en | de
UI_LANG=en
# Timezone used to display due dates
TZ=Europe/Berlin
# Set to 0 for a self-signed Vikunja certificate
VIKUNJA_VERIFY_TLS=1
LISTEN_PORT=8080
